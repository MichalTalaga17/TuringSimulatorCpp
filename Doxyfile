# Doxygen configuration for TuringSimulatorCpp.

PROJECT_NAME           = "Turing Machine Simulator"
PROJECT_BRIEF          = "Qt/C++ simulator jednotaśmowej deterministycznej maszyny Turinga"
OUTPUT_DIRECTORY       = docs/doxygen
OUTPUT_LANGUAGE        = Polish

INPUT                  = README.md \
                         docs/mainpage.dox \
                         include \
                         src \
                         tests
RECURSIVE              = YES
FILE_PATTERNS          = *.h \
                         *.cpp \
                         *.dox \
                         *.md
EXCLUDE                = build \
                         cmake-build-debug

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
MARKDOWN_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

QUIET                  = NO
